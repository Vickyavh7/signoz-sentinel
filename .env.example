# .env.example — copy to .env and fill in

SIGNOZ_URL=http://localhost:8080
MCP_URL=http://localhost:8000/mcp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=incident-sentinel

SIGNOZ_API_KEY=
LLM_API_KEY=
SLACK_WEBHOOK_URL=

LLM_PROVIDER=openai
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SECONDS=150
SENTINEL_MAX_STEPS=6

# Approximate USD per 1M tokens for cost metrics (adjust to your provider)
PRICE_INPUT_PER_MTOK=0.88
PRICE_OUTPUT_PER_MTOK=0.88
COST_BUDGET_USD=5.0
